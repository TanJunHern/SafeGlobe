# DueDilly environment settings
#
# Copy this file once per environment (both copies are gitignored, never commit them):
#   cp .env.example .env.dev    DEV, port 8080, works offline        npm run dev
#   cp .env.example .env.uat    UAT, port 8081 and Cloud Run         npm run uat / bash scripts/deploy.sh uat
#
# How to fill a block: delete the "#" at the start of its LAST line only, and replace the value after "=".
# No quotes, no spaces around "=". Every block may stay commented: the app then uses the fallback it names.
# Where each value comes from: DEPLOY_GUIDE.md, at the step given in the block.
# On Cloud Run, secrets (marked SECRET) come from Secret Manager, not from this file (DEPLOY_GUIDE.md step 12).

# ============================== Gemini ==============================

# --- Which Gemini backend the app uses: aistudio or vertex. Get it: DEPLOY_GUIDE.md steps 3 and 4.
# Fallback if left commented: aistudio in dev. In uat the app refuses to start until this is set.
# GEMINI_BACKEND=aistudio

# --- SECRET. Gemini API key from Google AI Studio. Get it: DEPLOY_GUIDE.md step 3.
# Fallback if left commented: Gemini disabled, labelled offline samples are shown.
# GEMINI_API_KEY=paste-here

# --- AI Studio model, tried first. Get it: DEPLOY_GUIDE.md step 3.
# Fallback if left commented: gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-flash-lite-latest

# --- AI Studio models tried next when the first is retired, over quota or overloaded. Get it: DEPLOY_GUIDE.md step 3.
# Fallback if left commented: gemini-flash-latest,gemini-3.1-flash-lite.
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite

# --- Google Cloud project for Vertex AI. Get it: DEPLOY_GUIDE.md step 4.
# Fallback if left commented: Vertex AI is not used.
# GOOGLE_CLOUD_PROJECT=safe-globe-compliance

# --- Vertex AI location your chosen model is served in (for example global). Get it: DEPLOY_GUIDE.md step 4.
# Fallback if left commented: Vertex AI is not used.
# GOOGLE_CLOUD_LOCATION=paste-here

# --- Vertex AI model, chosen from the models your project can use. Get it: DEPLOY_GUIDE.md step 4.
# Fallback if left commented: with GEMINI_BACKEND=vertex, Gemini is disabled and offline samples are shown.
# VERTEX_GEMINI_MODEL=paste-here

# --- Vertex AI models tried next, comma separated. Get it: DEPLOY_GUIDE.md step 4.
# Fallback if left commented: no second model is tried.
# VERTEX_GEMINI_FALLBACK_MODELS=paste-here

# ============================== ADK agents service (Pond-Guard, Ask Dilly) ==============================

# --- Address of the agents service. Local: http://localhost:8090 (npm run agents). Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: Pond-Guard shows the stored findings as an offline sample; Ask Dilly uses its built-in answers.
# AGENTS_SERVICE_URL=http://localhost:8090

# --- SECRET. Shared by the app and the agents service; any long random text, the same in both. Get it: DEPLOY_GUIDE.md step 12.
# Fallback if left commented: the agents service is not called.
# AGENTS_INTERNAL_TOKEN=paste-here

# --- Model the agents use, chosen from the models your project can use. Read by the agents service. Get it: DEPLOY_GUIDE.md step 4.
# Fallback if left commented: the agents service answers "not configured" and the app uses its offline fallback.
# AGENTS_MODEL=paste-here

# --- How much the agents' model "thinks" before answering: MINIMAL, LOW, MEDIUM or HIGH. Read by the agents service. Get it: DEPLOY_GUIDE.md step 4.
# Fallback if left commented: the model's own default (slower: about 60 seconds for a Pond-Guard run, against about 20 with LOW).
# AGENTS_THINKING_LEVEL=paste-here

# --- Set to TRUE for the agents to use Gemini on Vertex AI (with the project and location above). Get it: DEPLOY_GUIDE.md step 4.
# Fallback if left commented: the agents use the AI Studio key, or are offline without one.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE

# --- Live Pond-Guard screenings allowed per day, all users together. 0 means no limit. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: 30.
# POND_GUARD_DAILY_CAP=30

# --- AI requests one visitor may make per window. 0 switches the limit off. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: 20.
# AI_RATE_LIMIT_MAX=20

# --- Length of that window, in minutes. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: 10.
# AI_RATE_LIMIT_WINDOW_MINUTES=10

# ============================== Sign-in and security ==============================

# --- Demo mode: true shows "Try a demo account" on the login page (one click, no Google sign-in). Get it: DEPLOY_GUIDE.md step 11.
# Fallback if left commented: true in dev. In uat it is false, and people must sign in or create an account with Google.
# DEMO_MODE=true

# --- SECRET. Signs the one-time DDQ links and the sign-in sessions; any long random text. Get it: DEPLOY_GUIDE.md step 12.
# Fallback if left commented: a built-in development value in dev. In uat the app refuses to start without your own.
# JWT_SECRET=paste-here

# --- Google sign-in OAuth client ID (Web application). Get it: DEPLOY_GUIDE.md step 11.
# Fallback if left commented: "Sign in with Google" and "Create an account" show "not set up"; use a demo account (DEMO_MODE=true).
# GOOGLE_CLIENT_ID=paste-here.apps.googleusercontent.com

# --- No longer used. Compliance officers are now accounts: whoever creates a workspace, or is promoted in Settings. See DEPLOY_GUIDE.md step 11.
# Fallback if left commented: nothing changes. Setting it has no effect.
# COMPLIANCE_OFFICER_EMAILS=whitehathud@gmail.com

# --- Which websites may call the API. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: * (any).
# CORS_ORIGIN=*

# ============================== App ==============================

# --- Which environment this file is for: dev or uat. The run scripts set it for you. Get it: DEPLOY_GUIDE.md "How to paste a value".
# Fallback if left commented: the run script's value; plain "npm start" reads .env instead.
# APP_ENV=dev

# --- Port the server listens on. Cloud Run sets it itself. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: 8080.
# PORT=8080

# --- Where the SQLite database file is kept. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: ./data/safe_globe.db. On Cloud Run the data resets when the app restarts, and a banner says so.
# DATABASE_PATH=./data/safe_globe.db

# --- Default confidence (in %) a case needs to be auto-cleared or escalated. Officers can change it in Reviews. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: 80.
# CONFIDENCE_THRESHOLD=80

# --- Company name shown in the top bar. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: Meridian Commodities.
# WORKSPACE_NAME=Meridian Commodities

# ============================== Other Google services ==============================

# --- Google Maps browser key (Places Autocomplete and the map pin). Get it: DEPLOY_GUIDE.md step 11.
# Fallback if left commented: a built-in Singapore landmark picker.
# GOOGLE_MAPS_API_KEY=paste-here

# --- Where files are kept: local, or gcs for Cloud Storage. Today gcs applies to the crawler's page snapshots; DDQ uploads stay local until Phase 5. Get it: DEPLOY_GUIDE.md step 5.
# Fallback if left commented: local (a folder next to the database; on Cloud Run it is lost when the app restarts).
# DOCUMENT_STORAGE=local

# --- Cloud Storage bucket for DOCUMENT_STORAGE=gcs. Get it: DEPLOY_GUIDE.md step 5.
# Fallback if left commented: files are kept locally, whatever DOCUMENT_STORAGE says.
# GCS_BUCKET=paste-here

# ============================== Events, crawler agents, policy search (Phase 3) ==============================

# --- How events travel: inline (handled inside the app) or pubsub (Pub/Sub topics <env>-<event>). Get it: DEPLOY_GUIDE.md step 7.
# Fallback if left commented: inline. A failed Pub/Sub publish is also handled inline, so no event is lost.
# PUBSUB_MODE=inline

# --- The link a push from Pub/Sub or Cloud Scheduler must be addressed to (the app's own link). scripts/deploy.sh fills it in on Cloud Run. Get it: DEPLOY_GUIDE.md step 7.
# Fallback if left commented: POST /events/... answers 401 to everyone; use "Run now" in the Sources tab.
# PUBSUB_PUSH_AUDIENCE=paste-here

# --- The service account a push must be signed as (duedilly-run@<project>.iam.gserviceaccount.com). scripts/deploy.sh fills it in on Cloud Run. Get it: DEPLOY_GUIDE.md step 7.
# Fallback if left commented: as above.
# PUBSUB_PUSH_SERVICE_ACCOUNT=paste-here

# --- Live page extractions by the crawler agents per day, across all users. 0 means no cap. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: 50. When reached, the built-in pattern extractor is used ("Offline sample").
# CRAWLER_DAILY_CAP=50

# --- Ripples triage calls to Gemini per day. 0 means no cap. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: 200. When reached, alerts are rated by fixed rules ("Offline rules").
# TRIAGE_DAILY_CAP=200

# ============================== The review model (machine learning on officers' reviews) ==============================

# --- Where the review model is trained: local (inside the app) or bigquery (BigQuery ML boosted trees). Get it: DEPLOY_GUIDE.md step 6.
# Fallback if left commented: local. The "Offline model" is trained inside the app and labelled as such.
# BIGQUERY=local

# --- BigQuery dataset for the labelled reviews and the model. Get it: DEPLOY_GUIDE.md step 6.
# Fallback if left commented: duedilly_uat in uat, duedilly_dev otherwise.
# BIGQUERY_DATASET=paste-here

# --- Location of that dataset. Get it: DEPLOY_GUIDE.md step 6.
# Fallback if left commented: GCP_REGION, or asia-southeast1.
# BIGQUERY_LOCATION=asia-southeast1

# --- The most any ordinary BigQuery query may bill, in bytes. Get it: DEPLOY_GUIDE.md step 6.
# Fallback if left commented: 104857600 (100 MB). A query over the limit fails instead of costing money.
# BIGQUERY_MAX_BYTES_BILLED=104857600

# --- How many settings the hyperparameter tuning tries per training run (1 to 20). Get it: DEPLOY_GUIDE.md step 6.
# Fallback if left commented: 6. More trials take longer and cost more.
# ML_TUNING_TRIALS=6

# --- Training runs allowed per day, across all users. 0 means no cap. Get it: DEPLOY_GUIDE.md step 6.
# Fallback if left commented: 6.
# ML_TRAIN_DAILY_CAP=6

# --- Agent Search data store for policy search (duedilly-policies). Get it: DEPLOY_GUIDE.md step 8.
# Fallback if left commented: the built-in policy text answers ("Offline fallback").
# AGENT_SEARCH_DATA_STORE=paste-here

# --- Where that data store lives (global, us or eu). Get it: DEPLOY_GUIDE.md step 8.
# Fallback if left commented: global.
# AGENT_SEARCH_LOCATION=global

# --- Policy searches sent to Agent Search per day. 0 means no cap. Get it: DEPLOY_GUIDE.md step 8.
# Fallback if left commented: 200. When reached, the built-in policy text answers.
# AGENT_SEARCH_DAILY_CAP=200

# --- Document AI project for PDF and Word questionnaires. Not connected yet (Phase 5). Get it: DEPLOY_GUIDE.md step 9.
# Fallback if left commented: upload the template as a .md file; Gemini reads PDFs directly where built.
# DOCUMENT_AI_PROJECT_ID=safe-globe-compliance

# --- Document AI location (for example us). Get it: DEPLOY_GUIDE.md step 9.
# Fallback if left commented: as above.
# DOCUMENT_AI_LOCATION=paste-here

# --- Document AI Form Parser processor ID. Get it: DEPLOY_GUIDE.md step 9.
# Fallback if left commented: as above.
# DOCUMENT_AI_PROCESSOR_ID=paste-here

# --- Pub/Sub emulator started by docker-compose.dev.yml (dev only, used from Phase 3). Get it: DEPLOY_GUIDE.md step 7.
# Fallback if left commented: events are handled inside the app.
# PUBSUB_EMULATOR_HOST=localhost:8085

# ============================== Vessels ==============================

# --- SECRET. VesselFinder API key (exact positions). Get it: https://www.vesselfinder.com (optional).
# Fallback if left commented: the public VesselFinder vessel page is read.
# VESSELFINDER_API_KEY=paste-here

# --- Vessel lookup by IMO number: on or off. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: on. Off accepts vessels as "not verified" without going online.
# VESSELFINDER_LOOKUP=on

# --- Compliance Agent runtime: builtin. Get it: DEPLOY_GUIDE.md step 13.
# Fallback if left commented: builtin.
# AGENT_RUNTIME=builtin
