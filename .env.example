# Safe Globe Environment Configuration

# Server Port (Google Cloud Run automatically sets PORT=8080)
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database Settings ('sqlite' for local testing, 'firestore' or 'cloudsql' for GCP production)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/safe_globe.db

# Confidence Engine Threshold (Default 80%)
CONFIDENCE_THRESHOLD=80

# Google Cloud Platform (Required when deploying to GCP)
GCP_PROJECT_ID=safe-globe-compliance
GCP_REGION=asia-southeast1

# CORS Settings
CORS_ORIGIN=*

# Google AI Studio Gemini API Key
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Auth & Security
JWT_SECRET=safeglobe-ddq-secure-hmac-key-2026
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
COMPLIANCE_OFFICER_EMAILS=compliance@safeglobe.com,grace.teo@safeglobe.internal

# Google Maps (browser key for Places Autocomplete + map pin; leave blank for Singapore landmark mock fallback)
GOOGLE_MAPS_API_KEY=
