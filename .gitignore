node_modules/
.env
# Per-environment settings (APP_ENV=dev / uat); .env.example is the template
.env.*
!.env.example
data/safe_globe.db*
data/test_safe_globe.db*
# Accounts and the databases of created workspaces
data/*.accounts.db*
data/*.workspaces/
# Page snapshots kept by the crawler agents when Cloud Storage is not connected
data/*.objects/
data/uploads/*
# Local demo kit: scenario, sample files, DB backups, demo links (never pushed)
demo-data/
!data/uploads/.gitkeep
!data/uploads/**/.gitkeep
npm-debug.log*
.DS_Store
Thumbs.db
# Python bytecode (agents service)
__pycache__/
*.pyc

# Demo recordings and scratch files stay local
demovideo/
.scratch/
